# =============================================================================
# CS Portal (بوابة حاسبات) — Environment Configuration
# =============================================================================
# ZERO environment variables are required for Standalone Zero-DB deployment on
# Vercel or local development. When DATABASE_URL is unset, the portal gracefully
# runs 100% standalone with static curriculum data and browser-local state
# (localStorage) — no database URL, API keys, or external auth secrets needed.
#
# To enable full production features (Neon PostgreSQL cloud sync, activation
# codes, Gemini AI tutor, and protected video streaming), copy this file to
# `.env.local` (git-ignored) and configure the variables below.
# =============================================================================

# -----------------------------------------------------------------------------
# Site Metadata
# -----------------------------------------------------------------------------
# Optional: Canonical public site URL for OpenGraph metadata and canonical URLs.
# Leave unset for zero-config Vercel deployments, or set to your production
# domain (e.g. https://your-portal.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Neon PostgreSQL (Optional — Enables Accounts, Cloud Sync & Activation Codes)
# -----------------------------------------------------------------------------
# Pooled connection string (with `-pooler` in hostname) for serverless app runtime.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Direct (unpooled) connection string for Drizzle migrations (`npm run db:push` / `db:migrate`).
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Sign-In (Optional — Enables "Continue with Google")
# -----------------------------------------------------------------------------
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <YOUR_ORIGIN>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Admin Seeding (`npm run db:seed-admin`)
# -----------------------------------------------------------------------------
# Used only when running `npm run db:seed-admin` to upsert the initial admin user.
# ADMIN_EMAIL=admin@csportal.edu
# ADMIN_PASSWORD=change-me-strong-password
# ADMIN_NAME="Eng. Ahmed Amir"

# -----------------------------------------------------------------------------
# Gemini AI Study Assistant (Optional)
# -----------------------------------------------------------------------------
# Google AI Studio / Gemini API key for the in-workspace AI tutor.
# GEMINI_API_KEY=
# Gemini model identifier (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
# Daily AI chat request cap per user/actor (default: 25).
# AI_DAILY_LIMIT=25

# -----------------------------------------------------------------------------
# Protected Video Streaming & Signed Playback (Optional)
# -----------------------------------------------------------------------------
# Bunny Stream Pull Zone CDN host (e.g. vz-xxxxxxxx-xxx.b-cdn.net).
# BUNNY_STREAM_CDN_HOST=
# Bunny Stream URL token authentication key for signed video URLs.
# BUNNY_STREAM_TOKEN_KEY=
# HMAC signing secret for protected HLS video manifest/token endpoints.
# HLS_SIGNING_SECRET=
