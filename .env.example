# =============================================================================
# CS Portal (بوابة حاسبات) — Environment Configuration
# =============================================================================
# ZERO environment variables are required for Standalone Zero-DB deployment on
# Vercel or local development. The portal runs 100% standalone with static
# curriculum data and browser-local state (localStorage) — no database URL,
# API keys, or external auth secrets are needed.
#
# To customize local overrides, copy this file to `.env.local` (git-ignored).
# =============================================================================

# Optional: Canonical public site URL for OpenGraph metadata and canonical URLs.
# Leave unset for zero-config Vercel deployments, or set to your production
# domain (e.g. https://your-portal.vercel.app) when deploying on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
